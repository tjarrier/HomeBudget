DATABASE_URL=postgresql://homebudget:homebudget@127.0.0.1:5433/homebudget

# Better Auth
BETTER_AUTH_SECRET=change-moi-en-local-openssl-rand-base64-32
# Requise sur Vercel, en Production comme en Preview : c'est l'origine annoncee
# a Google, qui doit correspondre au caractere pres a un redirect URI enregistre
# dans la console (Google n'accepte aucun wildcard). Sur la cible Preview, posez
# le domaine de production du projet `home-budget-preview`, en target Production
# de ce projet — c'est celui que le workflow tire, et jamais l'URL d'un
# deploiement. Voir CLAUDE.md.
BETTER_AUTH_URL=http://localhost:3000

# Client OAuth Google (cree a la main dans la Google Cloud Console, Task 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Allowlist stricte : ces deux adresses, et personne d'autre.
ALLOWLIST_THOMAS=
ALLOWLIST_LIZ=

# PostHog
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
