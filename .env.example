DATABASE_URL=postgresql://homebudget:homebudget@127.0.0.1:5433/homebudget

# Better Auth
BETTER_AUTH_SECRET=change-moi-en-local-openssl-rand-base64-32
# En local et en CI seulement. Sur Vercel, ne PAS definir cette variable pour
# l'environnement Preview : `lib/origine.ts` derive l'URL de branche, stable,
# et une valeur explicite gagnerait sur cette derivation. Voir CLAUDE.md.
BETTER_AUTH_URL=http://localhost:3000

# Client OAuth Google (cree a la main dans la Google Cloud Console, Task 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Allowlist stricte : ces deux adresses, et personne d'autre.
ALLOWLIST_THOMAS=
ALLOWLIST_LIZ=
